{% assign block_id = 'surprise-discount-' | append: block.id %}
{% assign settings = shop.metafields["$app"].surprise_discount_settings.value %}
{% assign preview_mode = request.design_mode %}
{% assign offer_ready = settings.offerReady | default: false %}
{% assign discount_value = settings.discountValue | default: '15' | strip %}
{% assign discount_text = settings.automaticDiscountText | default: 'You get {discount} off this product' %}
{% assign current_price_text = settings.currentPriceText | default: 'Current product price after discount' %}
{% assign show_delay_seconds = settings.showDelaySeconds | default: 0 | plus: 0 %}
{% if show_delay_seconds < 0 %}{% assign show_delay_seconds = 0 %}{% endif %}
{% if show_delay_seconds > 60 %}{% assign show_delay_seconds = 60 %}{% endif %}
{% assign show_block = false %}
{% if request.page_type == 'product' %}
  {% assign show_block = true %}
{% endif %}
{% if settings.appliesTo == 'products' %}
  {% assign show_block = false %}
  {% for selected_product_id in settings.productIds %}
    {% assign current_product_id = product.id | append: '' %}
    {% assign selected_product_id_string = selected_product_id | append: '' %}
    {% if current_product_id == selected_product_id_string %}
      {% assign show_block = true %}
    {% endif %}
  {% endfor %}
{% elsif settings.appliesTo == 'collections' %}
  {% assign show_block = false %}
  {% for current_collection in product.collections %}
    {% for selected_collection_id in settings.collectionIds %}
      {% assign current_collection_id = current_collection.id | append: '' %}
      {% assign selected_collection_id_string = selected_collection_id | append: '' %}
      {% if current_collection_id == selected_collection_id_string %}
        {% assign show_block = true %}
      {% endif %}
    {% endfor %}
  {% endfor %}
{% endif %}
{% if settings.discountType == 'percentage' %}
  {% assign reward_value = discount_value | append: '%' %}
{% else %}
  {% assign reward_value = discount_value %}
{% endif %}
{% assign reward_text = discount_text | replace: '{discount}', reward_value %}
{% assign current_variant = product.selected_or_first_available_variant %}
{% assign original_price = current_variant.price %}
{% if settings.discountType == 'percentage' %}
  {% assign discount_amount = original_price | times: discount_value | divided_by: 100 %}
{% else %}
  {% assign discount_amount = discount_value | times: 100 %}
{% endif %}
{% assign discounted_price = original_price | minus: discount_amount %}
{% if discounted_price < 0 %}
  {% assign discounted_price = 0 %}
{% endif %}
{% if request.page_type == 'product' %}
  {% if preview_mode or offer_ready and show_block %}
<div id="{{ block_id }}" class="surprise-discount{% if show_delay_seconds > 0 and preview_mode == false %} surprise-discount--delayed{% endif %}" data-show-delay="{{ show_delay_seconds }}" style="--surprise-bg: {{ settings.backgroundColor | default: '#fff4d6' }}; --surprise-text: {{ settings.textColor | default: '#1f2933' }}; --surprise-button-bg: {{ settings.buttonColor | default: '#e85d04' }}; --surprise-button-text: {{ settings.buttonTextColor | default: '#ffffff' }}; --surprise-radius: {{ settings.buttonRadius | default: 8 }}px; --surprise-container-radius: {{ settings.containerRadius | default: 14 }}px; --surprise-message-size-desktop: {{ settings.messageSizeDesktop | default: 18 }}px; --surprise-message-size-mobile: {{ settings.messageSizeMobile | default: 16 }}px;">
  <div class="surprise-discount__content">
    <p class="surprise-discount__message">{{ settings.message | default: 'A little surprise is waiting for you' }}</p>
    <button class="surprise-discount__button" type="button"{% if settings.discountMode == 'coupon' and settings.couponCode == blank %} disabled{% endif %}>
      {{ settings.buttonLabel | default: 'Reveal my discount' }}
    </button>
    {% if settings.discountMode == 'coupon' %}
      <button class="surprise-discount__reward surprise-discount__coupon" type="button" hidden aria-live="polite" aria-label="Copy coupon code">
        <span class="surprise-discount__coupon-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg>
        </span>
        <span class="surprise-discount__coupon-copy">
          <span class="surprise-discount__coupon-label">Your coupon code</span>
          <strong>{{ settings.couponCode | default: 'YOUR-CODE' | upcase }}</strong>
        </span>
        <span class="surprise-discount__copied" aria-live="polite">Copy</span>
      </button>
    {% else %}
      <p class="surprise-discount__reward surprise-discount__automatic" hidden aria-live="polite">{{ reward_text }}</p>
    {% endif %}
    <p class="surprise-discount__price" hidden aria-live="polite">
      <span class="surprise-discount__price-label">{{ current_price_text }}</span>:
      <strong class="surprise-discount__discounted-price">{{ discounted_price | money }}</strong>
      <span class="surprise-discount__original-price">{{ original_price | money }}</span>
    </p>
  </div>
</div>

<style>
  #{{ block_id }} {
    background: var(--surprise-bg);
    color: var(--surprise-text);
    border-radius: var(--surprise-container-radius);
    padding: 28px;
    text-align: center;
  }

  #{{ block_id }}.surprise-discount--delayed {
    visibility: hidden;
  }

  #{{ block_id }}.surprise-discount--visible {
    visibility: visible;
  }

  #{{ block_id }} .surprise-discount__content {
    max-width: 520px;
    margin: 0 auto;
  }

  #{{ block_id }} [hidden] {
    display: none !important;
  }

  #{{ block_id }} .surprise-discount__message {
    margin: 0 0 18px;
    font-size: var(--surprise-message-size-desktop);
    line-height: 1.45;
  }

  @media (max-width: 749px) {
    #{{ block_id }} .surprise-discount__message {
      font-size: var(--surprise-message-size-mobile);
    }
  }

  #{{ block_id }} .surprise-discount__button {
    appearance: none;
    border: 0;
    border-radius: var(--surprise-radius);
    background: var(--surprise-button-bg);
    color: var(--surprise-button-text);
    cursor: pointer;
    display: block;
    font: inherit;
    font-weight: 700;
    margin: 0 auto;
    width: min(100%, 430px);
    padding: 13px 24px;
    transition: transform 160ms ease, opacity 160ms ease;
  }

  #{{ block_id }} .surprise-discount__button:hover:not(:disabled) {
    transform: translateY(-2px);
  }

  #{{ block_id }} .surprise-discount__button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }

  #{{ block_id }} .surprise-discount__code {
    display: inline-block;
  }

  #{{ block_id }} .surprise-discount__coupon {
    display: flex;
    align-items: center;
    gap: 14px;
    width: min(100%, 430px);
    margin: 22px auto 0;
    padding: 14px 16px;
    border: 1.5px dashed #111827;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.32);
    color: #111827;
    cursor: pointer;
    text-align: left;
    transition: background 160ms ease, transform 160ms ease;
  }

  #{{ block_id }} .surprise-discount__coupon:hover {
    background: rgba(255, 255, 255, 0.62);
    transform: translateY(-1px);
  }

  #{{ block_id }} .surprise-discount__coupon:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
  }

  #{{ block_id }} .surprise-discount__coupon-icon {
    display: grid;
    flex: 0 0 34px;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: #111827;
    color: #ffffff;
  }

  #{{ block_id }} .surprise-discount__coupon-icon svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  #{{ block_id }} .surprise-discount__coupon-copy {
    display: grid;
    min-width: 0;
    gap: 3px;
  }

  #{{ block_id }} .surprise-discount__coupon-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #{{ block_id }} .surprise-discount__coupon strong {
    overflow-wrap: anywhere;
    font-size: 1.05rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #{{ block_id }} .surprise-discount__copied {
    margin-left: auto;
    font-size: 0.78rem;
    font-weight: 700;
    white-space: nowrap;
  }

  #{{ block_id }} .surprise-discount__coupon.is-copied {
    border-style: solid;
  }

  #{{ block_id }} .surprise-discount__automatic {
    margin: 22px 0 0;
    font-weight: 600;
  }

  #{{ block_id }} .surprise-discount__price {
    margin: 14px 0 0;
    font-weight: 600;
  }

  #{{ block_id }} .surprise-discount__original-price {
    margin-left: 8px;
    opacity: 0.65;
    text-decoration: line-through;
  }
</style>

<script>
  (() => {
    const root = document.getElementById('{{ block_id }}');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const showDelaySeconds = Number(root.dataset.showDelay || 0);
    if (root.classList.contains('surprise-discount--delayed')) {
      window.setTimeout(() => root.classList.add('surprise-discount--visible'), showDelaySeconds * 1000);
    }

    const button = root.querySelector('.surprise-discount__button');
    const rewardElement = root.querySelector('.surprise-discount__reward');
    const priceElement = root.querySelector('.surprise-discount__price');
    const discountedPriceElement = root.querySelector('.surprise-discount__discounted-price');
    const originalPriceElement = root.querySelector('.surprise-discount__original-price');
    const couponElement = root.querySelector('.surprise-discount__coupon');
    const copiedElement = root.querySelector('.surprise-discount__copied');
    const mode = {{ settings.discountMode | default: 'coupon' | json }};
    const code = {{ settings.couponCode | default: '' | json }};
    const discountType = {{ settings.discountType | default: 'percentage' | json }};
    const discountValue = Number({{ discount_value | json }}) || 0;
    const currency = {{ shop.currency | json }};
    const productVariants = {{ product.variants | json }};
    const previewMode = {{ preview_mode | json }};
    if (!button || !rewardElement || (!previewMode && mode === 'coupon' && !code)) return;

    const formatMoney = (cents) => new Intl.NumberFormat(undefined, {
      style: 'currency',
      currency,
    }).format(Math.max(0, cents) / 100);

    const updateVariantPrice = (price) => {
      if (!discountedPriceElement || !originalPriceElement || typeof price !== 'number' || !Number.isFinite(price)) return;
      const discountCents = discountType === 'percentage'
        ? price * discountValue / 100
        : discountValue * 100;
      discountedPriceElement.textContent = formatMoney(price - discountCents);
      originalPriceElement.textContent = formatMoney(price);
    };

    const resetReveal = () => {
      rewardElement.hidden = true;
      if (priceElement) priceElement.hidden = true;
      button.disabled = !previewMode && mode === 'coupon' && !code;
      if (couponElement && copiedElement) {
        copiedElement.textContent = 'Copy';
        couponElement.classList.remove('is-copied');
      }
    };

    const burstConfetti = () => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const canvas = document.createElement('canvas');
      const context = canvas.getContext('2d');
      if (!context) return;

      const bounds = button.getBoundingClientRect();
      const pixelRatio = window.devicePixelRatio || 1;
      const width = window.innerWidth;
      const height = window.innerHeight;
      canvas.width = width * pixelRatio;
      canvas.height = height * pixelRatio;
      canvas.setAttribute('aria-hidden', 'true');
      Object.assign(canvas.style, {
        position: 'fixed',
        inset: '0',
        width: `${width}px`,
        height: `${height}px`,
        pointerEvents: 'none',
        zIndex: '2147483647',
      });
      document.body.appendChild(canvas);
      context.scale(pixelRatio, pixelRatio);

      const colors = ['#e85d04', '#ffba08', '#2a9d8f', '#4361ee', '#ef476f'];
      const originX = bounds.left + bounds.width / 2;
      const originY = bounds.top + bounds.height / 2;
      const particles = Array.from({ length: 90 }, () => {
        const angle = Math.random() * Math.PI * 2;
        const speed = 3 + Math.random() * 7;
        return {
          x: originX,
          y: originY,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed - 3,
          size: 4 + Math.random() * 5,
          rotation: Math.random() * Math.PI,
          spin: (Math.random() - 0.5) * 0.24,
          color: colors[Math.floor(Math.random() * colors.length)],
        };
      });
      const startTime = performance.now();

      const drawFrame = (time) => {
        const elapsed = time - startTime;
        if (elapsed >= 1400) {
          canvas.remove();
          return;
        }

        context.clearRect(0, 0, width, height);
        context.globalAlpha = Math.max(0, 1 - elapsed / 1400);
        particles.forEach((particle) => {
          particle.x += particle.vx;
          particle.y += particle.vy;
          particle.vy += 0.16;
          particle.rotation += particle.spin;
          context.save();
          context.translate(particle.x, particle.y);
          context.rotate(particle.rotation);
          context.fillStyle = particle.color;
          context.fillRect(-particle.size / 2, -particle.size / 2, particle.size, particle.size * 0.65);
          context.restore();
        });
        window.requestAnimationFrame(drawFrame);
      };

      window.requestAnimationFrame(drawFrame);
    };

    const updateFromSelectedVariant = () => {
      const variantInput = document.querySelector('form[action*="/cart/add"] [name="id"], [name="id"]');
      const variantId = variantInput && variantInput.value;
      const variant = productVariants.find((item) => String(item.id) === String(variantId));
      if (variant && variant.price !== undefined) {
        updateVariantPrice(Number(variant.price));
        resetReveal();
      }
    };

    const handleVariantChange = (event) => {
      const variant = event.detail && event.detail.variant;
      if (!variant || variant.price === undefined) return;
      const rawPrice = typeof variant.price === 'string' ? Number(variant.price) * 100 : Number(variant.price);
      updateVariantPrice(rawPrice);
      resetReveal();
    };

    document.addEventListener('variant:change', handleVariantChange);
    document.addEventListener('shopify:variant:change', handleVariantChange);
    document.addEventListener('change', (event) => {
      const target = event.target;
      const productForm = target && target.closest('form[action*="/cart/add"]');
      if (!productForm) return;
      window.setTimeout(updateFromSelectedVariant, target.name === 'id' ? 0 : 50);
    }, true);

    button.addEventListener('click', async () => {
      button.disabled = true;
      rewardElement.hidden = false;
      if (priceElement) priceElement.hidden = false;
      burstConfetti();
    });

    if (couponElement && copiedElement && code) {
      couponElement.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code);
          copiedElement.textContent = 'Copied';
          couponElement.classList.add('is-copied');
          window.setTimeout(() => {
            copiedElement.textContent = 'Copy';
            couponElement.classList.remove('is-copied');
          }, 1800);
        } catch {
          copiedElement.textContent = 'Copy manually';
        }
      });
    }
  })();
</script>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Surprise discount",
  "target": "section"
}
{% endschema %}
